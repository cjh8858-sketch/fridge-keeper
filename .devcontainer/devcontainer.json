{
  "name": "fridge-keeper",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [5173],
  "postCreateCommand": "npm ci",
  "customizations": {
    "vscode": {
